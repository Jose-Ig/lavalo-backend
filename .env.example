# Local development (SQLite); Go >=1.24 required.
SERVER_PORT=8080
GIN_MODE=debug
DATABASE_DSN=data/uash.db
# PostgreSQL: takes precedence over DATABASE_DSN. Required in release mode.
# DATABASE_URL=postgres://user:password@localhost:5432/uash?sslmode=disable
# Railway will provide PORT later; deployment is outside this stage.

# Checkout Pro Orders API. Disabled until you configure your TEST integration.
MP_ENABLED=false
MP_LIVE_MODE=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Seller/test seller ID (user_id) corresponding to the Orders token above, NOT the buyer.
MP_COLLECTOR_ID=
# Public HTTPS backend origin, no trailing /api/v1. Go does not auto-load .env files.
MP_PUBLIC_BASE_URL=https://your-backend.example.com

# Configure Order (Mercado Pago), type=order, in the TEST webhook panel.
# URL: MP_PUBLIC_BASE_URL + /api/v1/payments/webhook (not payment/Preferences).
